<Project TreatAsLocalProperty="Version;InformationalVersion;TargetFramework" Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>Shoko AniList Metadata</Title>
        <Authors>revam</Authors>
        <RepositoryUrl>https://github.com/ShokoAnime/Shoko.Plugin.Anilist</RepositoryUrl>
        <Version>1.5.1</Version>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU;x64</Platforms>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <PropertyGroup Label="Plugin">
        <PluginGenerateClass>true</PluginGenerateClass>
        <PluginID>e73c1e23-111a-4cf0-bab8-054b738c5101</PluginID>
        <PluginName>AniList</PluginName>
        <PluginOverview>Supplies AniList anime metadata, images, cast and crew, tags, studios, relations, recommendations and broadcast times for the `anilist` metadata source, through Shoko's metadata provider contract.</PluginOverview>
        <PluginIcon>Assets/icon.svg</PluginIcon>
        <PluginThumbnail>Assets/thumbnail.svg</PluginThumbnail>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shoko.Plugin.Anilist.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The server supplies the abstractions at runtime, and a plugin that
             ships its own copy resolves `IPlugin` against that copy and is then
             skipped without an error, so the runtime assets stay out. -->
        <PackageReference Include="Shoko.Abstractions" Version="$(ShokoAbstractionsVersion)" ExcludeAssets="runtime" PrivateAssets="All" />
        <!-- The server already loads Entity Framework Core and SQLite and
             configures the plugin's database, so they are referenced for
             compiling only. The version is the server's. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" ExcludeAssets="runtime;native" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pulls in Microsoft.Extensions.{Logging,DependencyInjection,Hosting,Http},
             and is what `Shoko.Abstractions` itself is built against. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- Injects the embedded plugin identity metadata the server reads
             during discovery, from the `Plugin*` properties above, and
             generates the plugin class from them. PrivateAssets alone is not
             enough: without ExcludeAssets the package's own MSBuild tasks and
             satellite assemblies end up in the plugin output. -->
        <PackageReference Include="Shoko.BuildTools.Targets" Version="0.8.0" PrivateAssets="All" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.203" PrivateAssets="All" />
        <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
    </ItemGroup>
</Project>
